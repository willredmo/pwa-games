{
  "name": "duel-deck",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "netcheck": "esbuild scripts/netcheck.ts --bundle --platform=node --format=cjs --log-level=error --outfile=node_modules/.cache/netcheck.cjs && node node_modules/.cache/netcheck.cjs",
    "synergy": "esbuild scripts/synergy.ts --bundle --platform=node --format=cjs --log-level=error --outfile=node_modules/.cache/synergy.cjs && node node_modules/.cache/synergy.cjs",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=cjs --log-level=error --outfile=node_modules/.cache/sim.cjs && node node_modules/.cache/sim.cjs",
    "telemetry": "esbuild scripts/telemetry.ts --bundle --platform=node --format=cjs --log-level=error --outfile=node_modules/.cache/telemetry.cjs && node node_modules/.cache/telemetry.cjs",
    "feedback": "esbuild scripts/feedback.ts --bundle --platform=node --format=cjs --log-level=error --outfile=node_modules/.cache/feedback.cjs && node node_modules/.cache/feedback.cjs",
    "release": "pnpm build && firebase deploy --only hosting:duel-deck"
  },
  "dependencies": {
    "@pwa-games/backend-client": "workspace:*",
    "html2canvas": "1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "7.4.1"
  }
}

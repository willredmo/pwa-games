{
  "rules": {
    ".read": false,
    ".write": false,
    "telemetry": {
      "duel-deck": {
        "$day": {
          ".validate": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$match": {
            ".validate": "$match.length <= 40",
            "meta": {
              ".write": "!data.exists()",
              ".validate": "newData.hasChildren(['v', 'mode', 'diff', 'at', 'c'])",
              "v": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "mode": { ".validate": "newData.val() === 'cpu' || newData.val() === 'online'" },
              "diff": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "at": { ".validate": "newData.isNumber()" },
              "c": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$other": { ".validate": false }
            },
            "rounds": {
              "$n": {
                ".write": "!data.exists()",
                ".validate": "$n.length <= 3 && newData.hasChildren(['won', 'hp'])",
                "offer": { "$i": { ".validate": "$i.length <= 1 && newData.isString() && newData.val().length <= 16" } },
                "picks": {
                  "$i": {
                    ".validate": "$i.length <= 1 && newData.hasChildren(['k', 'a', 'l'])",
                    "k": { ".validate": "newData.isString() && newData.val().length <= 16" },
                    "a": { ".validate": "newData.val() === 'p' || newData.val() === 'm' || newData.val() === 'r'" },
                    "l": { ".validate": "newData.isNumber()" },
                    "$other": { ".validate": false }
                  }
                },
                "rr": { ".validate": "newData.isNumber()" },
                "row": { "$i": { ".validate": "$i.length <= 1 && newData.isString() && newData.val().length <= 20" } },
                "foe": { "$i": { ".validate": "$i.length <= 1 && newData.isString() && newData.val().length <= 20" } },
                "won": { ".validate": "newData.isNumber()" },
                "hp": { "$i": { ".validate": "($i === '0' || $i === '1') && newData.isNumber()" } },
                "$other": { ".validate": false }
              }
            },
            "augs": {
              "$n": {
                ".write": "!data.exists()",
                ".validate": "$n.length <= 3 && newData.hasChildren(['t'])",
                "o": { "$i": { ".validate": "$i.length <= 1 && newData.isString() && newData.val().length <= 32" } },
                "t": { ".validate": "newData.isString() && newData.val().length <= 32" },
                "e": { ".validate": "newData.isString() && newData.val().length <= 32" },
                "rr": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "end": {
              ".write": "!data.exists()",
              ".validate": "newData.hasChildren(['won', 'rounds'])",
              "won": { ".validate": "newData.isNumber()" },
              "rounds": { ".validate": "newData.isNumber()" },
              "hp": { "$i": { ".validate": "($i === '0' || $i === '1') && newData.isNumber()" } },
              "aug": { "$i": { ".validate": "$i.length <= 2 && newData.isString() && newData.val().length <= 32" } },
              "foeAug": { "$i": { ".validate": "$i.length <= 2 && newData.isString() && newData.val().length <= 32" } },
              "mvp": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "feedback": {
      "duel-deck": {
        "$id": {
          ".write": "!data.exists()",
          ".validate": "$id.length <= 40 && newData.hasChildren(['kind', 'text', 'at', 'v'])",
          "kind": { ".validate": "newData.val() === 'bug' || newData.val() === 'idea'" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000" },
          "contact": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "at": { ".validate": "newData.isNumber()" },
          "v": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "c": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "ua": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "ctx": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "shot": { ".validate": "newData.isString() && newData.val().length <= 1000000 && newData.val().beginsWith('data:image/')" },
          "$other": { ".validate": false }
        }
      }
    },
    "rooms": {      "knock-hockey": {
        "$code": {
          ".read": "$code.length === 5",
          ".write": "$code.length === 5",
          ".validate": "newData.hasChildren(['host', 'createdAt'])",
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val())"
          },
          "guest": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
          },
          "presence": {
            "p1": {
              ".validate": "newData.isBoolean()"
            },
            "p2": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "looks": {
            "p1": {
              ".validate": "newData.hasChildren(['shaft', 'blade'])"
            },
            "p2": {
              ".validate": "newData.hasChildren(['shaft', 'blade'])"
            },
            "$other": {
              ".validate": false
            }
          },
          "match": {
            ".validate": "newData.hasChildren(['score', 'turn', 'puck', 'shots', 'startedAt'])"
          },
          "shot": {
            ".validate": "newData.hasChildren(['seq', 'by', 'x', 'y', 'vx', 'vy', 'angle', 'power'])"
          },
          "result": {
            ".validate": "newData.hasChildren(['seq', 'match'])"
          },
          "aim": {
            ".validate": "newData.hasChildren(['by', 'angle', 'power'])"
          },
          "left": {
            ".validate": "newData.isString()"
          },
          "rematch": {
            "p1": {
              ".validate": "newData.isBoolean()"
            },
            "p2": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "duel-deck": {
        "$code": {
          ".read": "$code.length === 5",
          ".write": "$code.length === 5",
          ".validate": "newData.hasChildren(['host', 'createdAt'])",
          "host": { ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val())" },
          "guest": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "match": { ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 1) + 1" },
          "rematch": {
            "p1": { ".validate": "newData.isNumber()" },
            "p2": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "rules": {
            ".validate": "newData.hasChildren(['startHp', 'easy', 'synergies', 'upgrades'])",
            "startHp": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 999 && newData.val() % 1 === 0 && (!data.exists() || data.val() === newData.val())" },
            "easy": { ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())" },
            "synergies": { ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())" },
            "upgrades": { ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())" },
            "levelCap": { ".validate": "(newData.val() === 8 || newData.val() === 10 || newData.val() === 12 || newData.val() === 15) && (!data.exists() || data.val() === newData.val())" },
            "$other": { ".validate": false }
          },
          "proto": { ".validate": "newData.isNumber()" },
          "presence": {
            "p1": {
              ".validate": "newData.isBoolean()"
            },
            "p2": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "commits": {
            "$player": {
              ".validate": "($player === 'p1' || $player === 'p2') && newData.hasChildren(['round'])",
              "round": {
                ".validate": "newData.isNumber()"
              },
              "lanes": {
                "$lane": {
                  "$spot": {
                    ".validate": "newData.hasChildren(['key', 'baseAtk', 'baseMaxHp'])",
                    "key": {
                      ".validate": "newData.isString() && newData.val().length <= 24"
                    },
                    "baseAtk": {
                      ".validate": "newData.isNumber()"
                    },
                    "baseMaxHp": {
                      ".validate": "newData.isNumber()"
                    },
                    "merges": {
                      ".validate": "newData.isNumber()"
                    },
                    "ref": {
                      ".validate": "newData.isString() && newData.val().length <= 24"
                    },
                    "grant": {
                      ".validate": "newData.hasChildren()"
                    },
                    "$other": {
                      ".validate": false
                    }
                  }
                }
              },
              "aug": {
                ".validate": "newData.hasChildren()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "emotes": {
            "p1": { ".validate": "newData.hasChildren(['i', 'n']) && newData.child('i').isNumber() && newData.child('i').val() >= 0 && newData.child('i').val() <= 7 && newData.child('n').isNumber()" },
            "p2": { ".validate": "newData.hasChildren(['i', 'n']) && newData.child('i').isNumber() && newData.child('i').val() >= 0 && newData.child('i').val() <= 7 && newData.child('n').isNumber()" },
            "$other": { ".validate": false }
          },
          "left": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}

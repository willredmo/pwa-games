{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "duel-deck",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "duel-deck",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "house-edge",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "house-edge",
        "dev",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "duel-deck-hosting",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "hosting:duel-deck",
        "--project",
        "roguelike-games"
      ],
      "port": 5176
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "auth,database",
        "--project",
        "roguelike-games"
      ],
      "port": 4000,
      "env": {
        "PATH": "/opt/homebrew/opt/openjdk/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "name": "duel-deck-emu",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "duel-deck",
        "dev:emu",
        "--port",
        "5178",
        "--strictPort"
      ],
      "port": 5178
    },
    {
      "name": "knock-hockey",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "knock-hockey",
        "dev",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177
    }
  ]
}
